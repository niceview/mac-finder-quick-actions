				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>HERDR=__HERDR__
TERM_APP=__TERM_APP__

t="$1"
[ -n "$t" ] || exit 0
[ -d "$t" ] || t="${t:h}"
label="${t:t}"

if "$HERDR" workspace create --cwd "$t" --label "$label" --focus &gt;/dev/null 2&gt;&amp;1; then
  # 워크스페이스는 만들어졌다. 이미 떠 있는 터미널이면 앞으로 가져오고,
  # 아니면 새로 띄워 기존 herdr 세션에 attach 한다.
  if pgrep -f "/$TERM_APP.app/Contents/MacOS/" &gt;/dev/null 2&gt;&amp;1; then
    open -a "$TERM_APP"
  else
    open -na "$TERM_APP" --args -e "$HERDR"
  fi
else
  # herdr 서버가 안 떠 있는 경우: 해당 폴더에서 herdr 를 새로 시작한다.
  open -na "$TERM_APP" --args --working-directory="$t" -e "$HERDR"
fi
</string>
